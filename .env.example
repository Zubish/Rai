# Local Rai API configuration. Keep real values in .env.local, never Git.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Hosted inference requires an HTTPS origin and this server-only credential.
# Local loopback inference is allowed only outside production.
OLLAMA_API_KEY=
RAI_API_PORT=8787

# Server-to-server RxLedger connection. Never expose these in the browser.
RXLEDGER_BASE_URL=https://rxledger.vercel.app
RXLEDGER_RAI_API_KEY=

# HealthPass aggregate analytics. Disabled until verified; all credentials server-only.
RAI_HEALTHPASS_ENABLED=false
RAI_HEALTHPASS_API_KEY=
HEALTHPASS_BASE_URL=
HEALTHPASS_RAI_API_KEY=
